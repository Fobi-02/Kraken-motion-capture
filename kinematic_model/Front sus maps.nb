    RowBox[{"sol\[Phi]", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{"eqns\[Phi]", ",", "guess"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"subs", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"sol\[Phi]", ",", 
        RowBox[{"dofSeq\[Phi]", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "setup", ",", "dataKine"}], 
       "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ICRwl", "=", 
     RowBox[{"intersection", "[", 
      RowBox[{
       RowBox[{"P12l", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P7l", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"P7l", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "/.", "subs"}], ",", 
       RowBox[{"P34l", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P6l", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"P6l", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "/.", "subs"}]}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"ICRwr", "=", 
     RowBox[{"intersection", "[", 
      RowBox[{
       RowBox[{"P12r", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P7r", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"P7r", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "/.", "subs"}], ",", 
       RowBox[{"P34r", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P6r", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"P6r", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "/.", "subs"}]}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"ICRchassis", "=", 
     RowBox[{"intersection", "[", 
      RowBox[{"ICRwl", ",", 
       RowBox[{"PClval", "/.", "subs"}], ",", "ICRwr", ",", 
       RowBox[{"PCrval", "/.", "subs"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"obtainedMotion\[Phi]", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "1"}], "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{"dofSeq\[Phi]", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "3", ",", "2"}], "]"}], "]"}], "*", 
      RowBox[{"180", "/", "\[Pi]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"obtainedMotion\[Phi]", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "2"}], "]"}], "]"}], "=", 
     RowBox[{"ICRchassis", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
