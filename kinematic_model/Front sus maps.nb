Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"obtainedMotionS", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"nsteps", "+", "1"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", "steering", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"obtainedMotionZ", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"nsteps", "+", "1"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", "bump", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"obtainedMotion\[Phi]", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"nsteps", "+", "1"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", "roll", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"nsteps", "+", "1"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"caster", " ", "in", " ", "steering"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqnsS", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Phi", "/.", 
        RowBox[{"dofSeqS", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "/.", "setup"}], "/.", 
      "dataKine"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"solS", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{"eqnsS", ",", "guess"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"subs", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"solS", ",", 
        RowBox[{"dofSeqS", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "setup", ",", "dataKine"}], 
       "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ICRwl", "=", 
     RowBox[{"intersection", "[", 
      RowBox[{
       RowBox[{"P12l", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P7l", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"P7l", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "/.", "subs"}], ",", 
       RowBox[{"P34l", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P6l", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"P6l", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "/.", "subs"}]}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"ICRwr", "=", 
     RowBox[{"intersection", "[", 
      RowBox[{
       RowBox[{"P12r", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P7r", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"P7r", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "/.", "subs"}], ",", 
       RowBox[{"P34r", "/.", "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P6r", "[", 
