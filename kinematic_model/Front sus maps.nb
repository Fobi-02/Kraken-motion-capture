Cell[BoxData[{
 RowBox[{
  RowBox[{"dofSeqZ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalDelta]Z", "[", "t", "]"}], "->", 
        RowBox[{"\[CapitalDelta]Zmin", "+", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalDelta]Zmax", "-", "\[CapitalDelta]Zmin"}], 
            ")"}], "/", "nsteps"}], "*", "i"}]}]}], ",", 
       RowBox[{
        RowBox[{"\[Delta]Driver", "[", "t", "]"}], "->", "0"}], ",", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "t", "]"}], "->", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "nsteps"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zVec", "=", 
   RowBox[{"dofSeqZ", "[", 
