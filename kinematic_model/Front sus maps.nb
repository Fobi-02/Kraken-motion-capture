Cell[BoxData[
 RowBox[{
  RowBox[{"evalTable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalDelta]Z", "[", "t", "]"}], "->", 
        RowBox[{"\[CapitalDelta]Zmin", "+", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalDelta]Zmax", "-", "\[CapitalDelta]Zmin"}], 
            ")"}], "/", "nsteps"}], "*", "i"}]}]}], ",", 
       RowBox[{
        RowBox[{"\[Delta]Driver", "[", "t", "]"}], "->", 
        RowBox[{"\[Delta]min", "+", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Delta]max", "-", "\[Delta]min"}], ")"}], "/", 
           "nsteps"}], "*", "j"}]}]}], ",", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "t", "]"}], "->", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "nsteps"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "nsteps"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9963010690407486`*^9, 3.9963011471800175`*^9}},
 CellLabel->
  "In[195]:=",ExpressionUUID->"d8ce6626-0362-7741-addc-a4fc05e4e19f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Logging", " ", "x9"}], ",", " ", "y9", ",", " ", "z9", ",", " ", 
    "\[CapitalDelta]z", ",", " ", "\[Delta]Driver"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"obtainedMotion", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nsteps", "+", "1"}], ",", 
         RowBox[{"nsteps", "+", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", 
      RowBox[{"nsteps", "+", "1"}]}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<=", 
        RowBox[{"nsteps", "+", "1"}]}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eqns", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Phi", "/.", 
            RowBox[{"evalTable", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "/.", "setup"}], "/.", 
          "dataKine"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"FindRoot", "[", 
          RowBox[{"eqns", ",", "guess"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"obtainedMotion", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "1"}], "]"}], "]"}], "=", 
         RowBox[{"sol", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", "xWl", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"obtainedMotion", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "2"}], "]"}], "]"}], "=", 
         RowBox[{"sol", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", "yWl", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"obtainedMotion", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "3"}], "]"}], "]"}], "=", 
         RowBox[{"sol", "[", 
          RowBox[{"[", 
           RowBox[{"5", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", "zWl", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"obtainedMotion", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "4"}], "]"}], "]"}], "=", 
         RowBox[{"evalTable", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", "\[CapitalDelta]z", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"obtainedMotion", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "5"}], "]"}], "]"}], "=", 
         RowBox[{"evalTable", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "2", ",", "2"}], "]"}], "]"}]}], 
        ";"}]}], 
      RowBox[{"(*", "\[Delta]Driver", "*)"}], "\[IndentingNewLine]", "]"}]}], 
    "]"}]}]}]], "Input",
