Cell["Importing vehicle data and suspension points", "Text",
 CellChangeTimes->{{3.968498524064764*^9, 
  3.968498532903557*^9}},ExpressionUUID->"a91a7cc0-6eec-7e49-b1dd-\
092afd49b7fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Data", " ", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"\"\<VehicleData.json\>\"", ",", "\"\<RawJson\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"VehicleData", "=", 
  RowBox[{
   RowBox[{"Normal", "[", "Data", "]"}], "/.", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"k_String", "->", "v_"}], ")"}], ":>", 
    RowBox[{"(", 
     RowBox[{
